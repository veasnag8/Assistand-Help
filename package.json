{
  "name": "ai-support-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Netlify-ready browser workspace for QR layout preparation.",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n app,video -c blue,green \"npm run dev\" \"npm run dev:video\"",
    "dev:video": "node server/video-download-server.js",
    "test": "node --test src/lib/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@netlify/blobs": "^10.7.8",
    "docx": "^9.7.1",
    "khmercal": "^0.1.0",
    "lucide-react": "^1.16.0",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "deno-bin": "^2.2.7",
    "ffmpeg-static": "^5.3.0",
    "vite": "^5.4.11"
  }
}
